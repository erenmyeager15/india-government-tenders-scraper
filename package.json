{
    "name": "india-government-tenders-scraper",
    "version": "1.0.0",
    "type": "module",
    "description": "Apify Actor for Indian government tender leads from GeM; CPPP extraction is unavailable",
    "author": "Apify Actor",
    "license": "Apache-2.0",
    "main": "dist/main.js",
    "scripts": {
        "audit:prod": "npm audit --omit=dev --audit-level=high",
        "build": "tsc",
        "lint": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "test": "npm run build && node --test dist/billing.test.js dist/routes.test.js dist/scan.test.js dist/monitoring.test.js dist/monitoring-storage.test.js",
        "start": "node dist/main.js"
    },
    "dependencies": {
        "apify": "^3.7.2",
        "pdf-parse": "^1.1.1",
        "undici": "~7.29.1"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@types/pdf-parse": "^1.1.5",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "overrides": {
        "brace-expansion": "5.0.12",
        "adm-zip": "0.6.1",
        "ip-address": "10.7.1"
    }
}
